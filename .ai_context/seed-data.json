
import { PrismaClient, DataSourceType, HazardType, AlertSeverity, BodyZone } from '@prisma/client';

const prisma = new PrismaClient();

async function main() {
  console.log('Start seeding...');

  // ==========================================
  // 1. Mission Creation
  // ==========================================
  const marsMission = await prisma.mission.create({
    data: {
      name: 'Mars Transit 2026',
      destination: 'Mars',
      phase: 'Cruise Phase',
      missionDay: 180,
      commDelaySeconds: 720,
    },
  });

  const artemis2 = await prisma.mission.create({
    data: {
      name: 'Artemis II',
      destination: 'Moon',
      phase: 'Lunar Flyby',
      missionDay: 10,
      commDelaySeconds: 3,
    },
  });

  const issExp64 = await prisma.mission.create({
    data: {
      name: 'International Space Station (ISS) / Expedition 64',
      destination: 'LEO',
      phase: 'Orbital Station',
      missionDay: 150,
      commDelaySeconds: 0,
    },
  });

  const chapea = await prisma.mission.create({
    data: {
      name: 'CHAPEA Mars Dune Alpha',
      destination: 'Mars Analog',
      phase: 'Isolation Habitat',
      missionDay: 365,
      commDelaySeconds: 1200,
    },
  });

  // ==========================================
  // 2. Crew Member Creation
  // ==========================================
  const sarahVance = await prisma.crewMember.create({
    data: {
      missionId: marsMission.id,
      name: 'Dr. Sarah Vance',
      role: 'Commander',
      age: 42,
      status: AlertSeverity.NOMINAL,
    },
  });

  const alexMercer = await prisma.crewMember.create({
    data: {
      missionId: marsMission.id,
      name: 'Dr. Alex Mercer',
      role: 'Mission Specialist',
      age: 42,
      status: AlertSeverity.ATTENTION,
    },
  });

  const davidSaint = await prisma.crewMember.create({
    data: {
      missionId: issExp64.id,
      name: 'David Saint-Jacques',
      role: 'Flight Engineer',
      age: 56,
      status: AlertSeverity.NOMINAL,
    },
  });

  const serenaAuon = await prisma.crewMember.create({
    data: {
      missionId: issExp64.id,
      name: 'Serena Auñón-Chancellor',
      role: 'Medical Specialist',
      age: 48,
      status: AlertSeverity.ATTENTION,
    },
  });

  // ==========================================
  // 3. Pre-flight Baseline Measurements
  // ==========================================
  await prisma.individualBaseline.create({
    data: {
      crewMemberId: alexMercer.id,
      zone: BodyZone.HEAD_EYES,
      baselineData: { OCT_thickness: 280, IOP: 15, visual_acuity: 1.0 },
    },
  });

  await prisma.individualBaseline.create({
    data: {
      crewMemberId: sarahVance.id,
      zone: BodyZone.SKELETON_MUSCLES,
      baselineData: { bmd_spine_t_score: 0.5, muscle_mass_kg: 68.5 },
    },
  });

  // ==========================================
  // 4. Medical Records
  // ==========================================
  await prisma.healthRecord.create({
    data: {
      crewMemberId: alexMercer.id,
      sourceType: DataSourceType.AUTO_TELEMETRY,
      zone: BodyZone.HEAD_EYES,
      metrics: { intraocularPressure: 18.5, octRetinalThickness: 285 },
      symptoms: ['Blurred Vision', 'Dizziness'],
      isOutdated: false,
    },
  });

  await prisma.healthRecord.create({
    data: {
      crewMemberId: sarahVance.id,
      sourceType: DataSourceType.DIAGNOSTIC_DEVICE,
      zone: BodyZone.CHEST_CARDIO,
      metrics: { heartRateResting: 68, sleepHours: 6.5, stressLevel: 4 },
      symptoms: ['Fatigue'],
      isOutdated: false,
    },
  });

  // ==========================================
  // 5. Habitat Environmental Records
  // ==========================================
  await prisma.environmentRecord.create({
    data: {
      missionId: marsMission.id,
      radiationCans: 0.85,
      totalRadiation: 1.25,
      pO2: 21.1,
      co2Ppm: 450,
      cabinPressure: 101.3,
      temperature: 21.5,
      humidity: 50.0,
    },
  });

  await prisma.environmentRecord.create({
    data: {
      missionId: issExp64.id,
      radiationCans: 0.45,
      totalRadiation: 0.65,
      pO2: 21.0,
      co2Ppm: 400,
      cabinPressure: 101.3,
      temperature: 22.0,
      humidity: 48.0,
    },
  });

  // ==========================================
  // 6. Alerts and Risks
  // ==========================================
  await prisma.alert.create({
    data: {
      missionId: marsMission.id,
      crewMemberId: alexMercer.id,
      hazardType: HazardType.ALTERED_GRAVITY,
      severity: AlertSeverity.CRITICAL,
      title: 'Optic Nerve Swelling Detected',
      message: 'Warning: Potential development of Spaceflight-Associated Neuro-Ocular Syndrome (SANS) detected.',
      isResolved: false,
    },
  });

  await prisma.alert.create({
    data: {
      missionId: marsMission.id,
      hazardType: HazardType.SPACE_RADIATION,
      severity: AlertSeverity.CRITICAL,
      title: 'High Cosmic Radiation Levels',
      message: 'Warning: Dangerous radiation levels detected, with potential exposure to Solar Particle Events (SPEs).',
      isResolved: false,
    },
  });

  // ==========================================
  // 7. Countermeasure Protocols
  // ==========================================
  await prisma.countermeasureProtocol.create({
    data: {
      title: 'Thigh Cuffs & Fluid Shift Protocol',
      hazard: HazardType.ALTERED_GRAVITY,
      description: 'Use of venous occlusion thigh cuffs to prevent fluid shifts toward the head and reduce the risk of SANS.',
      steps: [
        'Put on the thigh cuffs',
        'Set the pressure to 50 mmHg',
        'Wear for 3–6 hours',
      ],
    },
  });

  await prisma.countermeasureProtocol.create({
    data: {
      title: 'ARED & Zero T2 Musculoskeletal Countermeasure Protocol',
      hazard: HazardType.ALTERED_GRAVITY,
      description: 'A combination of resistance and aerobic training exercises designed to prevent muscle atrophy and bone loss.',
      steps: [
        'Perform resistance exercises on ARED for 2.5 hours per day',
        'Complete an aerobic session on Zero T2',
        'Record heart rate and exercise load',
      ],
    },
  });

  await prisma.countermeasureProtocol.create({
    data: {
      title: 'Radiation Storm Shelter & Shielding Protocol',
      hazard: HazardType.SPACE_RADIATION,
      description: 'Protective procedures to follow when solar flares or elevated radiation levels are detected.',
      steps: [
        'Record CANS readings',
        'Move to the designated radiation shelter',
        'Limit extravehicular activities (EVAs)',
      ],
    },
  });

  console.log('Seeding finished successfully.');
}

main()
  .catch((e) => {
    console.error(e);
    process.exit(1);
  })
  .finally(async () => {
    await prisma.$disconnect();
  });
