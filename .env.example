POSTGRES_DB=aura
POSTGRES_USER=aura
POSTGRES_PASSWORD=aura_local_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
API_PORT=3001
WEB_PORT=3000
AUTH_BOOTSTRAP_USERNAME=commander
HEALTH_SWEEP_ENABLED=true
HEALTH_SWEEP_INTERVAL_SECONDS=60
TASK_QUEUE_ENABLED=true
QUEUE_PREFIX=aura
WORKER_CONCURRENCY=4
# JWT_SECRET and AUTH_BOOTSTRAP_PASSWORD are generated into root .env on first launch.
# Optional external overrides: DATABASE_URL, DIRECT_URL, REDIS_URL.
# Local URLs are derived from the fields above, without TLS.
