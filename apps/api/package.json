{
  "name": "@aura/api",
  "private": true,
  "scripts": {
    "test": "npm run build && node --test test/*.test.cjs",
    "build": "npm --workspace @aura/shared-types run build && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "node ../../scripts/run.mjs dev",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:smoke": "tsx prisma/smoke.ts"
  },
  "dependencies": {
    "@aura/shared-types": "1.0.0",
    "bullmq": "^5.58.0",
    "ioredis": "^5.8.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/common": "^11.1.12",
    "@nestjs/core": "^11.1.12",
    "@nestjs/platform-express": "^11.1.12",
    "@prisma/client": "^6.19.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "prisma": "^6.19.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "@types/node": "^22.10.2",
    "@types/express": "^5.0.3"
  },
  "prisma": { "seed": "tsx prisma/seed.ts" }
}
