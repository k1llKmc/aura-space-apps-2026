datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
generator client {
  provider = "prisma-client-js"
}

enum DataSourceType {
  AUTO_TELEMETRY
  MANUAL_REPORT
  DIAGNOSTIC_DEVICE
}
enum HazardType {
  SPACE_RADIATION
  ALTERED_GRAVITY
  ISOLATION_CONFINEMENT
  DISTANCE_FROM_EARTH
  HOSTILE_ENVIRONMENT
}
enum AlertSeverity {
  NOMINAL
  ATTENTION
  CRITICAL
  OUTDATED
}
enum BodyZone {
  HEAD_EYES
  CHEST_CARDIO
  ABDOMEN_METABOLISM
  WHOLE_BODY_IMMUNE
  SKELETON_MUSCLES
}

enum UserRole {
  COMMANDER
  MEDICAL_OFFICER
  CREW_MEMBER
}

model User {
  id String @id @default(uuid())
  username String @unique
  passwordHash String
  role UserRole
  missionId String
  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  crewMemberId String?
  crewMember CrewMember? @relation(fields: [crewMemberId], references: [id], onDelete: Cascade)
  tokenVersion Int @default(0)
  disabled Boolean @default(false)
  createdAt DateTime @default(now())
  resolvedAlerts Alert[]
  auditEvents AuditEvent[]
  backgroundTasks BackgroundTask[]
  @@index([missionId])
}

model Mission {
  id String @id @default(uuid())
  name String @unique
  destination String
  phase String
  missionDay Int
  commDelaySeconds Int
  isCurrent Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  crewMembers CrewMember[]
  environmentLogs EnvironmentRecord[]
  alerts Alert[]
  users User[]
  auditEvents AuditEvent[]
  backgroundTasks BackgroundTask[]
}
model CrewMember {
  id String @id @default(uuid())
  missionId String
  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  name String
  role String
  photoUrl String?
  age Int
  status AlertSeverity @default(NOMINAL)
  lastSyncedAt DateTime @default(now())
  baselines IndividualBaseline[]
  healthRecords HealthRecord[]
  dailyChecks DailyHealthCheck[]
  users User[]
  alerts Alert[]
  auditEvents AuditEvent[]
  zoneStates ZoneState[]
  backgroundTasks BackgroundTask[]
  @@index([missionId])
}
model IndividualBaseline {
  id String @id @default(uuid())
  crewMemberId String
  crewMember CrewMember @relation(fields: [crewMemberId], references: [id], onDelete: Cascade)
  zone BodyZone
  baselineData Json
  createdAt DateTime @default(now())
  @@index([crewMemberId, zone])
}
model HealthRecord {
  id String @id @default(uuid())
  crewMemberId String
  crewMember CrewMember @relation(fields: [crewMemberId], references: [id], onDelete: Cascade)
  sourceType DataSourceType
  zone BodyZone?
  metrics Json
  units Json @default("{}")
  symptoms String[]
  isOutdated Boolean @default(false)
  recordedAt DateTime @default(now())
  @@index([crewMemberId, recordedAt])
}
model DailyHealthCheck {
  id String @id @default(uuid())
  crewMemberId String
  crewMember CrewMember @relation(fields: [crewMemberId], references: [id], onDelete: Cascade)
  checkDate String
  idempotencyKey String
  payload Json
  response Json
  xpEarned Int
  currentStreak Int
  recordedAt DateTime @default(now())
  @@unique([crewMemberId, checkDate])
  @@unique([crewMemberId, idempotencyKey])
}

model EnvironmentRecord {
  id String @id @default(uuid())
  missionId String
  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  radiationCans Float
  totalRadiation Float
  pO2 Float
  co2Ppm Float
  cabinPressure Float
  temperature Float
  humidity Float
  sourceType DataSourceType @default(AUTO_TELEMETRY)
  recordedAt DateTime @default(now())
  @@index([missionId, recordedAt])
}
model Alert {
  id String @id @default(uuid())
  missionId String
  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  crewMemberId String?
  crewMember CrewMember? @relation(fields: [crewMemberId], references: [id], onDelete: Cascade)
  hazardType HazardType
  severity AlertSeverity @default(ATTENTION)
  title String
  message String
  isResolved Boolean @default(false)
  resolvedAt DateTime?
  resolvedById String?
  resolvedBy User? @relation(fields: [resolvedById], references: [id], onDelete: SetNull)
  resolutionNote String?
  zone BodyZone?
  origin String @default("OPERATOR")
  dedupKey String? @unique
  createdAt DateTime @default(now())
  @@index([missionId, severity])
}
model CountermeasureProtocol {
  id String @id @default(uuid())
  title String
  hazard HazardType
  description String
  steps String[]
  @@unique([title])
}

model ZoneState {
  id String @id @default(uuid())
  crewMemberId String
  crewMember CrewMember @relation(fields: [crewMemberId], references: [id], onDelete: Cascade)
  zone BodyZone
  result Json
  evaluatedAt DateTime
  @@unique([crewMemberId, zone])
}

model AuditEvent {
  id String @id @default(uuid())
  missionId String
  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  crewMemberId String?
  crewMember CrewMember? @relation(fields: [crewMemberId], references: [id], onDelete: Cascade)
  actorId String?
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action String
  entityId String?
  details Json
  createdAt DateTime @default(now())
  @@index([missionId, createdAt])
  @@index([crewMemberId, createdAt])
}

enum TaskKind {
  TELEMETRY
  HEALTH_RECHECK
  SIMULATION
}

enum TaskState {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model BackgroundTask {
  id String @id @default(uuid())
  missionId String
  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  crewMemberId String?
  crewMember CrewMember? @relation(fields: [crewMemberId], references: [id], onDelete: Cascade)
  requesterId String?
  requester User? @relation(fields: [requesterId], references: [id], onDelete: SetNull)
  kind TaskKind
  state TaskState @default(PENDING)
  dedupKey String @unique
  payloadHash String
  payload Json
  result Json?
  errorCode String?
  attempts Int @default(0)
  generation Int @default(0)
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([state, publishedAt])
  @@index([missionId, createdAt])
}
